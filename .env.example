# Copia este archivo a .env.local y completa los valores. NO subas claves reales.
# Sin RESEND_API_KEY: en desarrollo los formularios responden éxito y escriben en consola;
# en producción responden un error amable.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hola@tinto.co
CONTACT_FROM_EMAIL="Tinto <no-reply@tu-dominio.com>"

# Origen público real, sin ruta ni parámetros. Obligatorio al compilar producción.
NEXT_PUBLIC_SITE_URL=https://example.com
